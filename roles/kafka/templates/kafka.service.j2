# {{ ansible_managed }}

[Unit]
Description=Apache Kafka (KRaft mode)
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/sysconfig/kafka
User={{ kafka_user }}
Group={{ kafka_group }}
WorkingDirectory={{ _kafka_home }}
ExecStart={{ _kafka_home }}/bin/kafka-server-start.sh {{ _kafka_config_path }}
ExecStop={{ _kafka_home }}/bin/kafka-server-stop.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
